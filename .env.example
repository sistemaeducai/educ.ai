# =============================================================
# EDUC.AI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha com suas credenciais
# NÃO COMMITAR O .env - use .env.example para versionamento
# =============================================================

# -------------------------------------------------------------
# SUPABASE - Obrigatório
# Encontre em: https://supabase.com/dashboard/project/SEU_ID/settings/api
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# -------------------------------------------------------------
# GOOGLE OAUTH - Obrigatório para login com Google
# Configure em: https://console.cloud.google.com/apis/credentials
# URIs autorizados: https://SEU_PROJECT_ID.supabase.co/auth/v1/callback
# -------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# -------------------------------------------------------------
# OPENAI - Opcional (IA pedagógica)
# Sem esta chave, o sistema usa respostas simuladas (mock)
# Obtenha em: https://platform.openai.com/api-keys
# -------------------------------------------------------------
VITE_OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# -------------------------------------------------------------
# CONFIGURAÇÕES OPCIONAIS
# -------------------------------------------------------------
# ID do projeto Supabase (para referência)
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID
