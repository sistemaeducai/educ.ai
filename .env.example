# =============================================================
# EDUC.AI - VARIÁVEIS DE AMBIENTE (exemplo)
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env
# =============================================================

# -------------------------------------------------------------
# SUPABASE
# -------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=seu_project_id_aqui
VITE_SUPABASE_URL=https://seu_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave publicável (API Keys do painel Supabase)
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# ⚠️ SOMENTE BACKEND — nunca use no frontend / nunca commite
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=...
SUPABASE_JWT_CURRENT_KEY=...
SUPABASE_JWT_PREVIOUS_KEY=...

# -------------------------------------------------------------
# SUPABASE - Banco de Dados (conexão direta — somente backend)
# -------------------------------------------------------------
SUPABASE_DB_HOST=db.seu_project_id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=sua_senha_aqui

# -------------------------------------------------------------
# GOOGLE OAUTH
# -------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# ⚠️ SOMENTE BACKEND — nunca use no frontend
GOOGLE_CLIENT_SECRET=GOCSPX-...

# -------------------------------------------------------------
# OPENAI (configurado via painel admin — deixar vazio aqui)
# -------------------------------------------------------------
# OPENAI_API_KEY=sua_chave_openai_aqui
